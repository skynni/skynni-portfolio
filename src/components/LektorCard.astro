---
// LektorCard.astro — karta lektorska
import AudioPlayer from './AudioPlayer.astro';
import type { LektorCard as LektorCardData } from '../data/lektorCards';

interface Props {
  card: LektorCardData;
}

const { card } = Astro.props;
---

<article class="lektor-card" id={card.id} role="listitem">
  <div class="lektor-card__icon" aria-hidden="true">
    <svg viewBox={card.iconViewBox} fill="none" stroke="currentColor" stroke-width="1.5">
      <path d={card.iconPath} />
    </svg>
  </div>
  <h3 class="lektor-card__title">{card.title}</h3>
  <p class="lektor-card__desc">{card.desc}</p>
  <div class="lektor-card__player">
    <AudioPlayer
      audioId={card.audioId}
      audioSrc={card.audioSrc}
      audioType={card.audioType}
      playBtnId={`play-${card.id}`}
      playBtnLabel={`Odtwórz próbkę: ${card.title}`}
      playerClass="player--lektor"
      regionLabel={`Odtwarzacz - lektorstwo ${card.title}`}
    />
  </div>
</article>
