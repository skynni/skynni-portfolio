---
// MusicTrack.astro — wiersz listy muzycznej
import AudioPlayer from './AudioPlayer.astro';
import type { Track } from '../data/tracks';

interface Props {
  track: Track;
}

const { track } = Astro.props;
const hasAcapella = Boolean(track.acapellaSrc);
---

<article class="music-track" id={track.id} role="listitem">
  <div class="music-track__num" aria-hidden="true">{track.num}</div>
  <div class="music-track__info">
    <div class="music-track__title-row">
      <h3 class="music-track__title">{track.title}</h3>
      {hasAcapella && (
        <div
          class="version-toggle"
          role="group"
          aria-label="Wybierz wersję utworu"
          data-track-id={track.id}
        >
          <button
            class="version-toggle__btn version-toggle__btn--active"
            id={`${track.id}-btn-normal`}
            data-version="normal"
            aria-pressed="true"
            aria-label="Wersja normalna"
          >
            Normalna
          </button>
          <button
            class="version-toggle__btn"
            id={`${track.id}-btn-acapella`}
            data-version="acapella"
            aria-pressed="false"
            aria-label="Wersja a cappella"
          >
            A cappella
          </button>
        </div>
      )}
    </div>
    <p class="music-track__genre">{track.genre}</p>
  </div>
  <div class="music-track__player">
    <!-- Wersja normalna -->
    <div class="version-player version-player--normal" data-track-id={track.id}>
      <AudioPlayer
        audioId={track.audioId}
        audioSrc={track.audioSrc}
        playBtnId={`play-${track.audioId.replace('audio-', '')}`}
        playBtnLabel={`Odtwórz utwór: ${track.title}`}
        playerClass="player--inline"
        regionLabel={`Odtwarzacz - ${track.title}`}
      />
    </div>
    <!-- Wersja a cappella (tylko jeśli istnieje) -->
    {hasAcapella && (
      <div class="version-player version-player--acapella" data-track-id={track.id} hidden>
        <AudioPlayer
          audioId={`${track.audioId}-acapella`}
          audioSrc={track.acapellaSrc!}
          playBtnId={`play-${track.audioId.replace('audio-', '')}-acapella`}
          playBtnLabel={`Odtwórz wersję a cappella: ${track.title}`}
          playerClass="player--inline"
          regionLabel={`Odtwarzacz A cappella - ${track.title}`}
        />
      </div>
    )}
  </div>
</article>
